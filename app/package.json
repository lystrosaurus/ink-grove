{
  "name": "ink-grove-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/build-content.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node ../scripts/build-content.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "content": "node ../scripts/build-content.mjs",
    "test": "node --test tests/*.test.js ../scripts/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "lucide-react": "^1.44.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.6",
    "vite": "^5.4.11"
  }
}
